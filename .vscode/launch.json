{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve tech-digest worker",
      "type": "debugpy",
      "request": "launch",
      "module": "worker.entrypoints.worker",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug worker tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "cwd": "${workspaceFolder}/apps/worker",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Smoke test: fetch HN front page",
      "type": "debugpy",
      "request": "launch",
      "module": "worker.workflows.smoke",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    }
  ]
}
